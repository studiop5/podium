{
  "manifest_version": 3,
  "name": "Podium PDF Viewer",
  "version": "1.1",
  "description": "Open PDF music scores with Podium, a specialized music notation PDF viewer",
  "permissions": [
    "contextMenus",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Podium PDF Viewer"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
